{
  "name": "crm-crocieriamo",
  "private": true,
  "version": "0.1.0",
  "description": "Workspace CRM Crocieriamo",
  "scripts": {
    "build": "npm --prefix backend install --include=dev && npm --prefix backend run build",
    "dev": "node scripts/dev.mjs",
    "start": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "import:leads:dry": "node scripts/import-crocieriamo-leads.mjs",
    "import:leads": "node scripts/import-crocieriamo-leads.mjs --apply"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
