{
  "manifest_version": 3,
  "name": "Leadium – Risposta automatica 3CX",
  "version": "0.5.0",
  "description": "Risponde nel client web 3CX al richiamo chiesto da Leadium. Le chiamate in arrivo si vedono e si prendono da qualsiasi programma, con una finestrella e una notifica.",
  "permissions": ["storage", "notifications"],
  "icons": { "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Leadium – Risposta automatica 3CX" },
  "content_scripts": [
    {
      "matches": ["https://leadium-crm.vercel.app/*", "http://localhost/*"],
      "js": ["leadium-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leadium-crm.vercel.app/*", "http://localhost/*"],
      "js": ["leadium-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.my3cx.it/*"],
      "js": ["threecx.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
